# Contador de espectadores (Redis de Upstash; en Vercel: Storage / Marketplace -> Upstash Redis)
# Si no se define, el contador simplemente no aparece.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
